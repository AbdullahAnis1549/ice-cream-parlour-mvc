@{
    ViewData["Title"] = "Privacy Protocol";
}

<div class="container py-5">
    <div class="luxury-card p-5 animate-slide-up">
        <h1 class="display-5 fw-bold mb-4" style="font-family: 'Playfair Display', serif; color: var(--luxury-gold); text-transform: uppercase; letter-spacing: 3px;">Privacy Protocol</h1>
        <p class="lead text-muted" style="letter-spacing: 1px;">At Sweet Scoops Parlor, your data privacy is handled with the same precision as our artisanal recipes.</p>
        
        <hr class="my-5 border-secondary">
        
        <div class="row">
            <div class="col-lg-8">
                <section class="mb-5">
                    <h3 class="text-uppercase small fw-bold mb-3" style="letter-spacing: 2px;">Data Collection</h3>
                    <p class="text-muted" style="line-height:1.8;">We collect information only necessary for providing our premium services, including account registration for secret recipes and shipping details for our archive books.</p>
                </section>

                <section class="mb-5">
                    <h3 class="text-uppercase small fw-bold mb-3" style="letter-spacing: 2px;">Security Measure</h3>
                    <p class="text-muted" style="line-height:1.8;">Our vault is protected by enterprise-grade encryption. Your financial details for memberships are never stored on our local servers.</p>
                </section>
            </div>
        </div>
    </div>
</div>

<style>
    .luxury-card {
        background: white;
        border: 1px solid #eee;
        border-left: 5px solid var(--luxury-gold);
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    }
    
    .animate-slide-up {
        animation: fadeInUp 0.8s ease-out;
    }

    @@keyframes fadeInUp {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
