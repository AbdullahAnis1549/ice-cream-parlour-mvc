@model WebApplication12.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "CREAMY DELIGHT - Artisanal Ice Cream";
}

<!-- Hero Carousel -->
<div id="heroCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel">
    <div class="carousel-inner">
        @if (Model.Slides != null && Model.Slides.Any())
        {
            int index = 0;
            @foreach (var slide in Model.Slides)
            {
                <div class="carousel-item @(index == 0 ? "active" : "")" style="background: linear-gradient(rgba(45, 26, 24, 0.6), rgba(75, 46, 43, 0.9)), url('@(string.IsNullOrEmpty(slide.ImageUrl) ? "https://images.unsplash.com/photo-1551024601-bec78aea704b?auto=format&fit=crop&q=80&w=2000" : slide.ImageUrl)'); background-size: cover; background-position: center;">
                    <div class="container h-100 d-flex align-items-center justify-content-center text-center">
                        <div>
                            <h1 class="hero-title display-2 fw-bold text-white mb-4" style="font-family: 'Playfair Display', serif; letter-spacing: 5px;">
                                @Html.Raw(slide.Title ?? "CREAMY <br /> <span style='color: var(--secondary-caramel);'>DELIGHT</span>")
                            </h1>
                            <p class="hero-subtitle lead text-white-50 mb-5 text-uppercase" style="letter-spacing: 3px; font-weight: 300;">@slide.Subtitle</p>
                            <div class="d-flex justify-content-center gap-4">
                                <a href="#deals-section" class="btn-hero-primary">Exclusive Deals</a>
                                <a asp-controller="Recipes" asp-action="Index" class="btn-hero-outline">Discover Menu</a>
                            </div>
                        </div>
                    </div>
                </div>
                index++;
            }
        }
        else
        {
             <div class="carousel-item active" style="background: linear-gradient(rgba(45, 26, 24, 0.6), rgba(75, 46, 43, 0.9)), url('https://images.unsplash.com/photo-1551024601-bec78aea704b?auto=format&fit=crop&q=80&w=2000'); background-size: cover; background-position: center;">
                <div class="container h-100 d-flex align-items-center justify-content-center text-center">
                    <div>
                        <h1 class="hero-title display-2 fw-bold text-white mb-4" style="font-family: 'Playfair Display', serif; letter-spacing: 5px;">
                            CREAMY <br />
                            <span style="color: var(--secondary-caramel);">DELIGHT</span>
                        </h1>
                        <p class="hero-subtitle lead text-white-50 mb-5 text-uppercase" style="letter-spacing: 3px; font-weight: 300;">Crafting Excellence. One Scoop at a Time.</p>
                        <div class="d-flex justify-content-center gap-4">
                            <a href="#deals-section" class="btn-hero-primary">Exclusive Deals</a>
                            <a asp-controller="Recipes" asp-action="Index" class="btn-hero-outline">Discover Menu</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
    </button>
</div>

<!-- Deals Section (Fetched from DB) -->
<div id="deals-section" class="container py-5 mt-5">
    <div class="text-center mb-5">
        <h2 class="section-title">Exclusive Offers</h2>
        <p class="text-muted text-uppercase small" style="letter-spacing: 2px;">Curated Deals from CREAMY DELIGHT</p>
    </div>
    <div class="row g-4 justify-content-center">
        @if (Model.Deals != null && Model.Deals.Any())
        {
            @foreach (var deal in Model.Deals)
            {
                <div class="col-md-4">
                    <div class="deal-card p-5 text-center h-100">
                        @if (!string.IsNullOrEmpty(deal.BadgeText))
                        {
                            <div class="deal-badge">@deal.BadgeText</div>
                        }
                        <h6 class="text-uppercase mb-3 small fw-bold" style="color: var(--luxury-gold);">@deal.Tagline</h6>
                        <h3 class="fw-bold mb-4">@deal.Title</h3>
                        <p class="text-muted small mb-4">@deal.Description</p>
                        <div class="price-tag mb-4">$@deal.Price</div>
                        <a asp-controller="Home" asp-action="Contact" class="btn-deal">
                            Reserve Entry
                        </a>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <p class="text-muted italic">Awaiting the next curated collection of seasonal offers.</p>
            </div>
        }
    </div>
</div>

<!-- Top Recipes Column (Requirement) -->
<div class="container py-5 mt-5">
    <div class="text-center mb-5">
        <h2 class="section-title">The Master Artisans</h2>
        <p class="text-muted">Masterpieces submitted by our elite community medalists.</p>
    </div>
    <div class="row g-4 justify-content-center">
        @if (Model.Winners != null && Model.Winners.Any())
        {
            @foreach (var submission in Model.Winners)
            {
                <div class="col-md-4">
                    <div class="feature-card h-100">
                        <div class="winner-badge"><i class="fa-solid fa-trophy me-1"></i> TOP RECIPE</div>
                        
                        @if(!string.IsNullOrEmpty(submission.ImageUrl))
                        {
                            <div class="hero-image" style="width: 100%; height: 250px; background: url('@submission.ImageUrl') center/cover; border-bottom: 1px solid #eee;"></div>
                        }
                        else
                        {
                            <!-- Placeholder for Hero Image -->
                            <div class="hero-placeholder d-flex align-items-center justify-content-center">
                                <i class="fa-solid fa-ice-cream fs-1 opacity-25"></i>
                            </div>
                        }

                        <div class="p-4">
                            <h5 class="text-uppercase fw-bold small" style="letter-spacing: 1px;">@submission.RecipeName</h5>
                            <p class="text-muted small">Winner: <strong>@submission.User?.Name</strong></p>
                            <span class="badge bg-dark rounded-0 px-3 py-2" style="border: 1px solid var(--luxury-gold); color: var(--luxury-gold);">PRIZE WON: $@submission.PrizeMoney</span>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- Promo Section -->
<div class="promo-banner mt-5 text-center">
    <div class="container">
        <h2 class="section-title mb-4" style="color: var(--luxury-gold);">The Inner Circle</h2>
        <p class="mb-5 text-white-50 text-uppercase" style="letter-spacing: 2px;">Reveal the guarded secrets of Mr. "A's" artisanal collection.</p>
        <a asp-controller="Account" asp-action="Register" class="btn-gold-outline">Request Membership</a>
    </div>
</div>

<style>
    html {
        scroll-behavior: smooth;
    }

    .carousel-item {
        min-height: 100vh;
        height: 100vh;
        margin-top: -61px;
        padding-top: 61px;
    }

    .hero-title {
        color: #fff;
        text-shadow: 0 10px 30px rgba(0,0,0,0.5);
        font-size: 6rem;
        line-height: 1;
    }

    .btn-hero-primary {
        background: var(--luxury-gold);
        color: var(--luxury-black);
        padding: 18px 50px;
        font-weight: 700;
        text-decoration: none;
        transition: 0.4s;
        text-transform: uppercase;
        letter-spacing: 2px;
        font-size: 11px;
    }

    .btn-hero-primary:hover { background: var(--pure-white); color: #000; }

    .btn-hero-outline {
        border: 2px solid var(--secondary-caramel);
        color: var(--secondary-caramel);
        padding: 17px 50px;
        font-weight: 700;
        text-decoration: none;
        transition: 0.4s;
        text-transform: uppercase;
        letter-spacing: 2px;
        font-size: 11px;
    }

    .btn-hero-outline:hover { background: var(--secondary-caramel); color: var(--primary-chocolate); }

    .deal-card { background: #fff; border: 1px solid #e8dfd7; position: relative; transition: 0.4s; }
    .deal-card.highlighted { background: var(--primary-chocolate); color: var(--accent-vanilla); border: 1px solid var(--secondary-caramel); }
    .deal-card:hover { transform: translateY(-10px); box-shadow: 0 20px 40px rgba(0,0,0,0.1); }
    
    .deal-badge { position: absolute; top: 20px; right: 20px; font-size: 10px; font-weight: 700; background: var(--luxury-gold); color: var(--luxury-black); padding: 5px 10px; letter-spacing: 1px; }
    .price-tag { font-size: 32px; font-family: 'Playfair Display', serif; font-weight: 700; }
    
    .btn-deal { text-decoration: none; color: var(--luxury-black); border-bottom: 2px solid var(--luxury-gold); text-transform: uppercase; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
    .btn-deal-gold { text-decoration: none; color: var(--luxury-gold); border: 1px solid var(--luxury-gold); padding: 10px 25px; text-transform: uppercase; font-size: 11px; font-weight: 700; letter-spacing: 1px; transition: 0.3s; }
    .btn-deal-gold:hover { background: var(--luxury-gold); color: var(--luxury-black); }

    .feature-card { background: white; border: 1px solid #eee; position: relative; overflow: hidden; }
    
    .hero-placeholder {
        width: 100%;
        height: 250px;
        background: #f9f9f9;
        color: #ccc;
        border-bottom: 1px solid #eee;
    }

    .winner-badge { position: absolute; top: 15px; left: 15px; background: var(--luxury-gold); padding: 5px 12px; font-size: 10px; font-weight: 700; color: #000; letter-spacing: 1px; z-index: 2; }

    .promo-banner { background: var(--luxury-black); border-top: 5px solid var(--secondary-caramel); padding: 100px 0; }
    .btn-gold-outline { border: 1px solid var(--luxury-gold); color: var(--luxury-gold); padding: 15px 45px; text-transform: uppercase; letter-spacing: 2px; font-size: 13px; text-decoration: none; transition: 0.4s; }
    .btn-gold-outline:hover { background: var(--luxury-gold); color: var(--luxury-black); }

    .section-title { 
        font-family: 'Playfair Display', serif; 
        color: var(--luxury-black); 
        font-weight: 700; 
        text-transform: uppercase; 
        letter-spacing: 6px; 
        font-size: 36px; 
        margin-bottom: 60px;
        position: relative;
        display: inline-block;
    }
    .section-title::after {
        content: '';
        position: absolute;
        width: 50px;
        height: 2px;
        background: var(--luxury-gold);
        bottom: -15px;
        left: 50%;
        transform: translateX(-50%);
    }
    .promo-banner .section-title { color: var(--luxury-gold); margin-bottom: 25px; }
    .promo-banner .section-title::after { display: none; }

    /* Responsive adjustments */
    @@media (max-width: 768px) {
        .hero-title {
            font-size: 3.5rem;
            letter-spacing: 2px !important;
        }
        .hero-subtitle {
            font-size: 1rem;
            letter-spacing: 1px !important;
            margin-bottom: 2rem !important;
        }
        .btn-hero-primary, .btn-hero-outline {
            padding: 12px 25px;
            font-size: 10px;
            width: 100%;
        }
        .d-flex.justify-content-center.gap-4 {
            flex-direction: column;
            gap: 1rem !important;
            padding: 0 20px;
        }
        .carousel-item {
            min-height: 80vh;
            height: 80vh;
        }
        .section-title {
            font-size: 28px;
            letter-spacing: 3px;
        }
        .deal-card {
            padding: 2rem !important;
        }
        .promo-banner {
            padding: 60px 20px;
        }
    }
</style>
