@model WebApplication12.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Artisanal Ice Cream & Recipes";
}

<!-- Hero Carousel -->
<div id="heroCarousel" class="carousel slide carousel-fade" data-bs-interval="false" aria-label="Featured ice cream">
    <div class="carousel-inner">
        @if (Model.Slides != null && Model.Slides.Any())
        {
            int index = 0;
            @foreach (var slide in Model.Slides)
            {
                <div class="carousel-item @(index == 0 ? "active" : "")" style="background: linear-gradient(rgba(45, 26, 24, 0.6), rgba(75, 46, 43, 0.9)), url('@(string.IsNullOrEmpty(slide.ImageUrl) ? Url.Content("~/images/seeds/vanilla_bean_odyssey_1777111994350.png") : slide.ImageUrl)'); background-size: cover; background-position: center;">
                    <div class="container hero-content text-center">
                        <div>
                            <h1 class="hero-title display-2 fw-bold text-white mb-4" style="font-family: 'Playfair Display', serif; letter-spacing: 5px;">
                                @(slide.DisplayTitle ?? "Creamy Delight")
                            </h1>
                            <p class="hero-subtitle lead text-white-50 mb-5 text-uppercase" style="letter-spacing: 3px; font-weight: 300;">@slide.Subtitle</p>
                            <div class="hero-actions">
                                <a asp-controller="Recipes" asp-action="Index" class="btn-hero-primary">Explore Recipes</a>
                                <a href="#deals-section" class="btn-hero-outline">See Offers</a>
                            </div>
                        </div>
                    </div>
                </div>
                index++;
            }
        }
        else
        {
             <div class="carousel-item active" style="background: linear-gradient(rgba(45, 26, 24, 0.6), rgba(75, 46, 43, 0.9)), url('@Url.Content("~/images/seeds/vanilla_bean_odyssey_1777111994350.png")'); background-size: cover; background-position: center;">
                <div class="container hero-content text-center">
                    <div>
                        <h1 class="hero-title display-2 fw-bold text-white mb-4" style="font-family: 'Playfair Display', serif; letter-spacing: 5px;">
                            CREAMY <br />
                            <span style="color: var(--secondary-caramel);">DELIGHT</span>
                        </h1>
                        <p class="hero-subtitle lead text-white-50 mb-5 text-uppercase" style="letter-spacing: 3px; font-weight: 300;">Crafting Excellence. One Scoop at a Time.</p>
                        <div class="hero-actions">
                            <a asp-controller="Recipes" asp-action="Index" class="btn-hero-primary">Explore Recipes</a>
                            <a href="#deals-section" class="btn-hero-outline">See Offers</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
    @if (Model.Slides?.Count() > 1)
    {
        <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev" aria-label="Previous slide">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next" aria-label="Next slide">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
        </button>
    }
</div>

<!-- Deals Section (Fetched from DB) -->
<div id="deals-section" class="container py-5">
    <div class="text-center mb-5">
        <h2 class="section-title">Exclusive Offers</h2>
        <p class="text-muted text-uppercase small" style="letter-spacing: 2px;">Curated Deals from CREAMY DELIGHT</p>
    </div>
    <div class="row g-4 justify-content-center">
        @if (Model.Deals != null && Model.Deals.Any())
        {
            @foreach (var deal in Model.Deals)
            {
                <div class="col-sm-6 col-lg-4">
                    <div class="deal-card text-center h-100">
                        @if (!string.IsNullOrEmpty(deal.BadgeText))
                        {
                            <div class="deal-badge">@deal.BadgeText</div>
                        }
                        <h6 class="text-uppercase mb-3 small fw-bold" style="color: var(--luxury-gold);">@deal.Tagline</h6>
                        <h3 class="fw-bold mb-4">@deal.Title</h3>
                        <p class="text-muted small mb-4">@deal.Description</p>
                        <div class="price-tag mb-4">$@deal.Price</div>
                        <a asp-controller="Home" asp-action="Contact" class="btn-deal">
                            Ask About This Offer
                        </a>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <p class="text-muted italic">No seasonal offers are available right now.</p>
            </div>
        }
    </div>
</div>

<!-- Top Recipes Column (Requirement) -->
<div class="container py-5">
    <div class="text-center mb-5">
        <h2 class="section-title">Community Recipes</h2>
        <p class="text-muted">Award-winning recipes from our community.</p>
    </div>
    <div class="row g-4 justify-content-center">
        @if (Model.Winners != null && Model.Winners.Any())
        {
            @foreach (var submission in Model.Winners)
            {
                <div class="col-sm-6 col-lg-4">
                    <div class="feature-card h-100">
                        <div class="winner-badge"><i class="fa-solid fa-trophy me-1"></i> TOP RECIPE</div>
                        
                        @if(!string.IsNullOrEmpty(submission.ImageUrl))
                        {
                            <div class="hero-image" style="width: 100%; height: 250px; background: url('@submission.ImageUrl') center/cover; border-bottom: 1px solid #eee;"></div>
                        }
                        else
                        {
                            <!-- Placeholder for Hero Image -->
                            <div class="hero-placeholder d-flex align-items-center justify-content-center">
                                <i class="fa-solid fa-ice-cream fs-1 opacity-25"></i>
                            </div>
                        }

                        <div class="p-4">
                            <h5 class="text-uppercase fw-bold small" style="letter-spacing: 1px;">@submission.RecipeName</h5>
                            <p class="text-muted small">Winner: <strong>@submission.User?.Name</strong></p>
                            <span class="badge bg-dark rounded-0 px-3 py-2" style="border: 1px solid var(--luxury-gold); color: var(--luxury-gold);">PRIZE WON: $@submission.PrizeMoney</span>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- Promo Section -->
<div class="promo-banner mt-5 text-center">
    <div class="container">
        <h2 class="section-title mb-4" style="color: var(--luxury-gold);">The Inner Circle</h2>
        <p class="mb-5 text-white-50 text-uppercase" style="letter-spacing: 2px;">Reveal the guarded secrets of Mr. "A's" artisanal collection.</p>
        <a asp-controller="Account" asp-action="Register" class="btn-gold-outline">Join Creamy Delight</a>
    </div>
</div>

<style>
    #heroCarousel .carousel-item { background-color: #382422; }
    .hero-content {
        min-height: clamp(24rem, 66vh, 44rem);
        display: grid;
        place-items: center;
        padding: clamp(3rem, 8vw, 7rem) clamp(2.75rem, 8vw, 7rem);
    }
    .hero-title {
        font-size: clamp(2rem, 7vw, 5.5rem);
        line-height: 1.05;
        overflow-wrap: anywhere;
        text-shadow: 0 5px 20px rgba(0,0,0,.45);
    }
    .hero-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: .75rem; }
    #heroCarousel .carousel-control-prev, #heroCarousel .carousel-control-next { width: min(10%, 4rem); }
    #heroCarousel .carousel-control-prev-icon, #heroCarousel .carousel-control-next-icon { width: 1.5rem; }
    .hero-actions a { border-radius: .625rem; padding-inline: clamp(1rem, 3vw, 2rem); }

    .btn-hero-primary {
        background: var(--luxury-gold);
        color: var(--luxury-black);
        padding: 18px 50px;
        font-weight: 700;
        text-decoration: none;
        transition: 0.4s;
        text-transform: uppercase;
        letter-spacing: 2px;
        font-size: 11px;
    }

    .btn-hero-primary:hover { background: var(--pure-white); color: #000; }

    .btn-hero-outline {
        border: 2px solid var(--secondary-caramel);
        color: var(--secondary-caramel);
        padding: 17px 50px;
        font-weight: 700;
        text-decoration: none;
        transition: 0.4s;
        text-transform: uppercase;
        letter-spacing: 2px;
        font-size: 11px;
    }

    .btn-hero-outline:hover { background: var(--secondary-caramel); color: var(--primary-chocolate); }

    .deal-card { background: #fff; border: 1px solid #e8dfd7; position: relative; border-radius: 1rem; padding: clamp(1.25rem, 4vw, 2.5rem); }
    .deal-card.highlighted { background: var(--primary-chocolate); color: var(--accent-vanilla); border: 1px solid var(--secondary-caramel); }
    .deal-card:hover { transform: translateY(-10px); box-shadow: 0 20px 40px rgba(0,0,0,0.1); }
    
    .deal-badge { display: inline-block; margin-bottom: .75rem; border-radius: .375rem; font-size: 10px; font-weight: 700; background: var(--luxury-gold); color: var(--luxury-black); padding: 5px 10px; letter-spacing: 1px; }
    .price-tag { font-size: 32px; font-family: 'Playfair Display', serif; font-weight: 700; }
    
    .btn-deal { text-decoration: none; color: var(--luxury-black); border-bottom: 2px solid var(--luxury-gold); text-transform: uppercase; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
    .btn-deal-gold { text-decoration: none; color: var(--luxury-gold); border: 1px solid var(--luxury-gold); padding: 10px 25px; text-transform: uppercase; font-size: 11px; font-weight: 700; letter-spacing: 1px; transition: 0.3s; }
    .btn-deal-gold:hover { background: var(--luxury-gold); color: var(--luxury-black); }

    .feature-card { background: white; border: 1px solid #eee; position: relative; overflow: hidden; border-radius: 1rem; }
    
    .hero-placeholder {
        width: 100%;
        height: 250px;
        background: #f9f9f9;
        color: #ccc;
        border-bottom: 1px solid #eee;
    }

    .winner-badge { position: absolute; top: 15px; left: 15px; background: var(--luxury-gold); padding: 5px 12px; font-size: 10px; font-weight: 700; color: #000; letter-spacing: 1px; z-index: 2; }

    .promo-banner { background: var(--luxury-black); border-top: 5px solid var(--secondary-caramel); padding: clamp(3rem, 8vw, 6rem) 0; }
    .btn-gold-outline { display: inline-block; max-width: 100%; border-radius: .625rem; border: 1px solid var(--luxury-gold); color: var(--luxury-gold); padding: 15px clamp(1rem, 5vw, 2.75rem); text-transform: uppercase; letter-spacing: 2px; font-size: 13px; text-decoration: none; transition: 0.4s; }
    .btn-gold-outline:hover { background: var(--luxury-gold); color: var(--luxury-black); }

    .section-title { 
        font-family: 'Playfair Display', serif; 
        color: var(--luxury-black); 
        font-weight: 700; 
        text-transform: uppercase; 
        letter-spacing: 6px; 
        font-size: clamp(1.5rem, 4vw, 2.25rem);
        margin-bottom: 1.75rem;
        position: relative;
        display: inline-block;
    }
    .section-title::after {
        content: '';
        position: absolute;
        width: 50px;
        height: 2px;
        background: var(--luxury-gold);
        bottom: -15px;
        left: 50%;
        transform: translateX(-50%);
    }
    .promo-banner .section-title { color: var(--luxury-gold); margin-bottom: 25px; }
    .promo-banner .section-title::after { display: none; }

    @@media (min-width: 1200px) and (min-height: 600px) {
        .hero-content {
            /* Allow for the desktop brand, navbar padding, and bottom border. */
            min-height: calc(100vh - 68px);
            min-height: calc(100svh - 68px);
        }
    }

    @@media (max-width: 575.98px) {
        .hero-title { letter-spacing: 1px !important; }
        .hero-subtitle { font-size: 1rem; letter-spacing: 1px !important; }
        .hero-actions { flex-direction: column; }
        .section-title { letter-spacing: 2px; }
    }
</style>
