@model WebApplication12.Models.Feedback
@{
    ViewData["Title"] = "Contact CREAMY DELIGHT";
}

<div class="container py-5">
    <div class="row g-5">
        <div class="col-lg-5">
            <h1 class="parlor-title display-4 mb-4">The <span class="text-gold">Concierge</span></h1>
            <p class="text-muted mb-5">Inquiry or indulgence? Reach out to our master churners for bespoke arrangements.</p>
            
            <div class="contact-info-list">
                <div class="d-flex align-items-center mb-4 p-3 contact-card">
                    <div class="contact-icon-circle me-3"><i class="fa-solid fa-location-dot"></i></div>
                    <div>
                        <h6 class="mb-0 fw-bold text-uppercase small" style="letter-spacing: 1px;">The Grand Branch</h6>
                        <p class="mb-0 text-muted small">123 Ice Cream Lane, Dessert City</p>
                    </div>
                </div>
                
                <div class="d-flex align-items-center mb-4 p-3 contact-card">
                    <div class="contact-icon-circle me-3"><i class="fa-solid fa-phone"></i></div>
                    <div>
                        <h6 class="mb-0 fw-bold text-uppercase small" style="letter-spacing: 1px;">Direct Line</h6>
                        <p class="mb-0 text-muted small">+1 (555) SWEET-00</p>
                    </div>
                </div>

                <div class="d-flex align-items-center mb-4 p-3 contact-card">
                    <div class="contact-icon-circle me-3"><i class="fa-solid fa-envelope"></i></div>
                    <div>
                        <h6 class="mb-0 fw-bold text-uppercase small" style="letter-spacing: 1px;">Electronic Mail</h6>
                        <p class="mb-0 text-muted small">hello@sweetscoops.com</p>
                    </div>
                </div>
            </div>

            <div class="mt-5 p-4 bg-soft-luxury">
                <h5 class="fw-bold mb-4 text-uppercase fw-700" style="color: var(--luxury-gold); letter-spacing: 2px; font-size: 13px;">Experience Hours</h5>
                <div class="d-flex justify-content-between mb-3 border-bottom border-secondary pb-2">
                    <span class="small text-uppercase">Mon - Fri</span>
                    <span class="fw-bold small">10:00 AM - 10:00 PM</span>
                </div>
                <div class="d-flex justify-content-between pb-2">
                    <span class="small text-uppercase">Sat - Sun</span>
                    <span class="fw-bold small">09:00 AM - 12:00 AM</span>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="feedback-form-card p-4 p-md-5 h-100">
                <h4 class="mb-4 text-uppercase fw-bold" style="font-family: 'Playfair Display', serif; letter-spacing: 2px;">Leave a <span style="color: var(--luxury-gold);">Testimonial</span></h4>
                <form asp-action="Feedback" method="post">
                    <div class="mb-4">
                        <label asp-for="Name" class="form-label text-uppercase small fw-bold">Identification</label>
                        <input asp-for="Name" class="form-control feedback-input" placeholder="Your Full Name" required />
                        <span asp-validation-for="Name" class="text-danger small d-block mt-1"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Email" class="form-label text-uppercase small fw-bold">Communication ID</label>
                        <input asp-for="Email" class="form-control feedback-input" placeholder="Your Email Address" required />
                        <span asp-validation-for="Email" class="text-danger small d-block mt-1"></span>
                    </div>
                    <div class="mb-5">
                        <label asp-for="Message" class="form-label text-uppercase small fw-bold">The Sentiment</label>
                        <textarea asp-for="Message" class="form-control feedback-textarea" rows="6" placeholder="Your detailed feedback..." required></textarea>
                        <span asp-validation-for="Message" class="text-danger small d-block mt-1"></span>
                    </div>
                    <button type="submit" class="btn-send-luxury w-100">Transmit Sentiment</button>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .parlor-title { font-family: 'Playfair Display', serif; color: var(--luxury-black); font-weight: 700; text-transform: uppercase; letter-spacing: 2px; }
    .text-gold { color: var(--luxury-gold); }
    
    .contact-card {
        background: white;
        border: 1px solid #eee;
        transition: 0.3s;
        border-left: 2px solid var(--luxury-gold);
    }
    .contact-card:hover {
        border-color: var(--luxury-gold);
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    }

    .contact-icon-circle {
        width: 40px;
        height: 40px;
        background: var(--luxury-black);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--luxury-gold);
        font-size: 18px;
    }

    .bg-soft-luxury { background: var(--luxury-black); color: white; }

    .feedback-form-card {
        background: white;
        border: 1px solid #eee;
        border-right: 5px solid var(--luxury-gold);
        box-shadow: 0 20px 50px rgba(0,0,0,0.05);
    }

    .feedback-input, .feedback-textarea {
        border-radius: 0;
        border: 1px solid #ddd;
        padding: 12px;
    }

    .feedback-input:focus, .feedback-textarea:focus {
        border-color: var(--luxury-gold);
        box-shadow: none;
        outline: none;
    }

    .btn-send-luxury {
        background: var(--luxury-black);
        color: var(--luxury-gold);
        border: 1px solid var(--luxury-gold);
        padding: 18px;
        text-transform: uppercase;
        font-weight: 700;
        letter-spacing: 2px;
        font-size: 12px;
        transition: 0.4s;
    }

    .btn-send-luxury:hover {
        background: var(--luxury-gold);
        color: var(--luxury-black);
    }

    /* Responsive adjustments */
    @@media (max-width: 768px) {
        .parlor-title {
            font-size: 2.5rem;
        }
        .feedback-form-card {
            padding: 2rem !important;
        }
    }
</style>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
