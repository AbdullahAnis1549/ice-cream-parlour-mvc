@model WebApplication12.Models.BookOrder
@{
    ViewData["Title"] = "Checkout - " + Model.Book?.Title;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="checkout-card animate-pop-in">
                <div class="row g-0">
                    <div class="col-md-4 order-summary-section">
                        <div class="p-4 p-lg-5 h-100 d-flex flex-column">
                            <h4 class="mb-4 text-white">Order Summary</h4>
                            <div class="text-center mb-4">
                                @if (Model.Book != null && !string.IsNullOrEmpty(Model.Book.ImageUrl))
                                {
                                    <img src="@Model.Book.ImageUrl" alt="@Model.Book.Title" class="img-fluid rounded-3 shadow" style="max-height: 200px;">
                                }
                                else
                                {
                                    <div class="bg-white rounded-3 p-4 d-inline-block shadow">
                                        <i class="fa-solid fa-book fs-1 text-gold"></i>
                                    </div>
                                }
                            </div>
                            <h5 class="text-white text-center mb-2">@Model.Book?.Title</h5>
                            <hr class="border-white opacity-25">
                            <div class="d-flex justify-content-between text-white my-3">
                                <span>Item Price</span>
                                <strong>$@Model.Book?.Price</strong>
                            </div>
                            <div class="d-flex justify-content-between text-white my-3">
                                <span>Shipping</span>
                                <strong>FREE</strong>
                            </div>
                            <div class="d-flex justify-content-between text-white mt-auto pt-3">
                                <span class="fs-5">Total</span>
                                <strong class="fs-4">$@Model.TotalCost</strong>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-8">
                        <div class="p-4 p-lg-5">
                            <h2 class="auth-header-title mb-4">Authenticate Details</h2>
                            <form asp-action="Order" method="post">
                                <input type="hidden" asp-for="BookId" />
                                <input type="hidden" asp-for="TotalCost" />

                                <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

                                <div class="row g-3 mb-4">
                                    <div class="col-md-6">
                                        <label asp-for="CustomerName" class="form-label small fw-bold">Full Name</label>
                                        <input asp-for="CustomerName" class="form-control rounded-pill-custom" required />
                                        <span asp-validation-for="CustomerName" class="text-danger small d-block mt-1"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="Email" class="form-label small fw-bold">Email Address</label>
                                        <input asp-for="Email" class="form-control rounded-pill-custom" required />
                                        <span asp-validation-for="Email" class="text-danger small d-block mt-1"></span>
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="Phone" class="form-label small fw-bold">Contact Number</label>
                                    <input asp-for="Phone" class="form-control rounded-pill-custom" placeholder="03xxxxxxxxx" required />
                                    <span asp-validation-for="Phone" class="text-danger small d-block mt-1"></span>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="Address" class="form-label small fw-bold">Delivery Address</label>
                                    <textarea asp-for="Address" class="form-control rounded-corner-custom" rows="3" required></textarea>
                                    <span asp-validation-for="Address" class="text-danger small d-block mt-1"></span>
                                </div>

                                <h4 class="mb-3 mt-5">Payment Option</h4>
                                <div class="payment-selection p-3 rounded-4 mb-4">
                                    <div class="form-check mb-3">
                                        <input class="form-check-input" type="radio" value="Credit Card" id="payCC" checked asp-for="PaymentMethod">
                                        <label class="form-check-label d-flex align-items-center" for="payCC">
                                            <i class="fa-solid fa-credit-card me-2 fs-5"></i> Credit Card
                                        </label>
                                    </div>
                                    <div class="form-check mb-3">
                                        <input class="form-check-input" type="radio" value="Debit Card" id="payDC" asp-for="PaymentMethod">
                                        <label class="form-check-label d-flex align-items-center" for="payDC">
                                            <i class="fa-regular fa-credit-card me-2 fs-5"></i> Debit Card
                                        </label>
                                    </div>
                                    <div class="row g-3 cc-details">
                                        <div class="col-12">
                                            <input type="text" class="form-control rounded-pill-custom" placeholder="Card Number" name="CardNumber" required>
                                        </div>
                                        <div class="col-6">
                                            <input type="text" class="form-control rounded-pill-custom" placeholder="MM/YY" name="CardExpiry" required>
                                        </div>
                                        <div class="col-6">
                                            <input type="password" class="form-control rounded-pill-custom" placeholder="CVV" name="CardCvv" required>
                                        </div>
                                    </div>
                                </div>

                                <button type="submit" class="btn-checkout w-100">Complete Transaction 🍨</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600&display=swap');

    .checkout-card {
        background: white;
        border-radius: 30px;
        overflow: hidden;
        box-shadow: 0 30px 60px rgba(0,0,0,0.1);
    }

    .order-summary-section {
        background: #1a1a1a;
        color: white;
        border-right: 3px solid #d4af37;
    }

    .text-gold { color: #d4af37; }

    .auth-header-title {
        font-family: 'Fredoka', sans-serif;
        color: #4a4a4a;
        font-weight: 600;
    }

    .rounded-pill-custom {
        border-radius: 50px !important;
        padding: 10px 20px;
        border: 2px solid #f0f0f0;
    }

    .rounded-corner-custom {
        border-radius: 20px !important;
        padding: 15px;
        border: 2px solid #f0f0f0;
    }

    .payment-selection { background: #fdfdfd; border: 1px solid #eee; }

    .btn-checkout {
        background: #d4af37;
        color: #1a1a1a;
        border: none;
        padding: 15px;
        border-radius: 50px;
        font-weight: 700;
        font-size: 18px;
        box-shadow: 0 10px 20px rgba(212, 175, 55, 0.3);
        transition: 0.3s;
    }

    .btn-checkout:hover {
        background: #1a1a1a;
        color: #d4af37;
        transform: translateY(-3px);
    }

    .animate-pop-in { animation: popIn 0.8s ease-out; }
    @@keyframes popIn {
        from { opacity: 0; transform: scale(0.95) translateY(20px); }
        to { opacity: 1; transform: scale(1) translateY(0); }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
