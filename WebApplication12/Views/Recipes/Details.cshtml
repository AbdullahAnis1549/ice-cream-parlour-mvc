@model WebApplication12.Models.Recipe
@{
    ViewData["Title"] = Model.Name + " - Private Recipe";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="recipe-detail-card animate-pop-in">
                <div class="row g-0">
                    <div class="col-md-5">
                        <div class="detail-img-box">
                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid h-100 w-100 object-cover">
                            }
                            else
                            {
                                <div class="placeholder-large"><i class="fa-solid fa-ice-cream fs-huge"></i></div>
                            }
                        </div>
                    </div>
                    <div class="col-md-7">
                        <div class="p-4 p-lg-5">
                            <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-4 pb-3 border-bottom border-dark">
                                <h1 class="flavor-name">@Model.Name</h1>
                                <span class="badge-premium">Gold Collection</span>
                            </div>
                            <p class="description lead text-muted" style="font-weight: 300;">@Model.Description</p>
                            
                            <div class="section-title mb-3 mt-5">
                                <i class="fa-solid fa-list-check me-2" style="color: var(--luxury-gold);"></i> Elements
                            </div>
                            <ul class="ingredient-list">
                                @foreach (var line in Model.Ingredients.Split('\n'))
                                {
                                    if (!string.IsNullOrWhiteSpace(line))
                                    {
                                        <li><i class="fa-solid fa-square me-2" style="font-size: 8px; vertical-align: middle;"></i> @line.Trim()</li>
                                    }
                                }
                            </ul>

                            <div class="section-title mt-5 mb-3">
                                <i class="fa-solid fa-wand-magic-sparkles me-2" style="color: var(--luxury-gold);"></i> The Craft
                            </div>
                            <div class="procedure-box p-4">
                                @Html.Raw(Model.Procedure.Replace("\n", "<br/>"))
                            </div>

                            <div class="mt-5 d-flex flex-wrap gap-3">
                                <a asp-action="Index" class="btn-luxury-back">Back To Collection</a>
                                <button class="btn-luxury-print" onclick="downloadPdf()">Download Recipe PDF</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script>
        function downloadPdf() {
            var element = document.querySelector('.recipe-detail-card').cloneNode(true);
            
            // Remove the buttons container from the clone
            var buttonsContainer = element.querySelector('.d-flex.gap-3');
            if (buttonsContainer) buttonsContainer.remove();
            
            var opt = {
              margin:       10,
              filename:     '@Html.Raw(Model.Name.Replace("'", ""))_Manuscript.pdf',
              image:        { type: 'jpeg', quality: 0.98 },
              html2canvas:  { scale: 2, useCORS: true },
              jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' }
            };
            
            html2pdf().set(opt).from(element).save();
        }
    </script>
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600&display=swap');

    .recipe-detail-card {
        background: white;
        border-radius: 0;
        overflow: hidden;
        box-shadow: 0 40px 100px rgba(0,0,0,0.1);
        border: 1px solid #eee;
    }

    .detail-img-box {
        height: 100%;
        min-height: 400px;
        background: var(--luxury-black);
        position: relative;
    }

    .detail-img-box img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        position: absolute;
        top: 0;
        left: 0;
    }

    .placeholder-large {
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--luxury-gold);
        font-size: 100px;
        position: absolute;
        width: 100%;
    }

    .flavor-name {
        font-family: 'Playfair Display', serif;
        color: var(--luxury-black);
        font-weight: 700;
        margin: 0;
        text-transform: uppercase;
        letter-spacing: 3px;
    }

    .badge-premium {
        background: var(--luxury-gold);
        color: var(--luxury-black);
        padding: 8px 20px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .section-title {
        font-family: 'Montserrat', sans-serif;
        font-size: 14px;
        font-weight: 700;
        color: var(--luxury-black);
        text-transform: uppercase;
        letter-spacing: 2px;
    }

    .ingredient-list {
        list-style: none;
        padding: 0;
        display: grid;
        grid-template-columns: 1fr;
        gap: 12px;
    }

    .ingredient-list li {
        color: #555;
        font-size: 14px;
        letter-spacing: 0.5px;
    }

    .procedure-box {
        background: #fafafa;
        color: #444;
        line-height: 2;
        border-left: 2px solid var(--luxury-gold);
        font-size: 15px;
    }

    .btn-luxury-back {
        text-decoration: none;
        color: #888;
        font-weight: 600;
        padding: 12px 30px;
        transition: 0.3s;
        text-transform: uppercase;
        font-size: 11px;
        letter-spacing: 1px;
    }

    .btn-luxury-back:hover {
        background: #f5f5f5;
        color: var(--luxury-black);
    }

    .btn-luxury-print {
        border: 1px solid var(--luxury-gold);
        background: var(--luxury-gold);
        color: var(--luxury-black);
        padding: 12px 35px;
        font-weight: 700;
        transition: 0.3s;
        text-transform: uppercase;
        font-size: 11px;
        letter-spacing: 1px;
    }

    .btn-luxury-print:hover {
        background: var(--pure-white);
        color: var(--luxury-black);
    }

    .animate-pop-in {
        animation: popIn 0.8s cubic-bezier(0.17, 0.67, 0.83, 0.67);
    }

    @@keyframes popIn {
        from { opacity: 0; transform: scale(0.95) translateY(20px); }
        to { opacity: 1; transform: scale(1) translateY(0); }
    }

    @@media (max-width: 768px) {
        .ingredient-list { grid-template-columns: 1fr; }
        .detail-img-box { min-height: 300px; height: 300px; }
    }

    @@media print {
        .navbar, .footer, .btn-back, .btn-print, .badge-premium { display: none !important; }
        .recipe-detail-card { box-shadow: none; border: none; }
        body { background: white; }
    }
</style>
