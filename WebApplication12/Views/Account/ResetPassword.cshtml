@{
    ViewData["Title"] = "Reset Password";
}

<div class="auth-container">
    <div class="auth-card animate-pop-in">
        <div class="auth-header">
            <div class="ice-cream-icon">🔒</div>
            <h1>Reset Password</h1>
            <p>Enter the code sent to your email and your new password</p>
        </div>

        <form asp-action="ResetPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="error-summary"></div>

            <input type="hidden" name="email" value="@ViewBag.Email" />

            <div class="input-group">
                <label>Reset Code</label>
                <input type="text" name="resetCode" placeholder="Enter 6-digit code from email" required />
            </div>

            <div class="input-group">
                <label>New Password</label>
                <input type="password" name="newPassword" placeholder="Min. 6 characters" minlength="6" required />
            </div>

            <div class="input-group">
                <label>Confirm Password</label>
                <input type="password" name="confirmPassword" placeholder="Repeat new password" minlength="6" required />
            </div>

            <button type="submit" class="btn-primary">Reset Password</button>

            <div class="auth-footer">
                <a asp-action="ForgotPassword">Resend Code</a> | <a asp-action="Login">Back to Login</a>
            </div>
        </form>
    </div>
</div>

<style>
    .auth-container {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 60px 20px;
    }

    .auth-card {
        background: rgba(255, 255, 255, 0.95);
        padding: 40px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.1);
        max-width: 500px;
        width: 100%;
        border: 1px solid #eee;
        border-top: 4px solid var(--luxury-gold);
    }

    .auth-header { text-align: center; margin-bottom: 30px; }
    .ice-cream-icon { font-size: 50px; margin-bottom: 10px; }
    .auth-header h1 {
        font-family: 'Playfair Display', serif;
        color: var(--luxury-black);
        font-size: 28px;
        text-transform: uppercase;
        letter-spacing: 2px;
    }
    .auth-header p { color: #888; font-size: 14px; }

    .input-group { margin-bottom: 20px; }
    .input-group label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
        color: var(--luxury-black);
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }
    .input-group input {
        width: 100%;
        padding: 14px 16px;
        border: 1px solid #ddd;
        font-size: 15px;
        transition: all 0.3s;
        box-sizing: border-box;
    }
    .input-group input:focus {
        border-color: var(--luxury-gold);
        outline: none;
    }

    .btn-primary {
        width: 100%;
        background: var(--luxury-black);
        color: var(--luxury-gold);
        border: 1px solid var(--luxury-gold);
        padding: 16px;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        transition: 0.3s;
        text-transform: uppercase;
        letter-spacing: 2px;
    }
    .btn-primary:hover {
        background: var(--luxury-gold);
        color: var(--luxury-black);
    }

    .auth-footer {
        text-align: center;
        margin-top: 25px;
        font-size: 14px;
        color: #777;
    }
    .auth-footer a {
        color: var(--luxury-gold);
        text-decoration: none;
        font-weight: 700;
    }

    .error-summary {
        background: #fff5f5;
        border-left: 4px solid #ff4757;
        padding: 10px;
        margin-bottom: 20px;
        color: #ff4757;
        font-size: 13px;
    }

    .animate-pop-in { animation: popIn 0.6s ease-out; }
    @@keyframes popIn {
        from { opacity: 0; transform: scale(0.95) translateY(20px); }
        to { opacity: 1; transform: scale(1) translateY(0); }
    }
</style>
