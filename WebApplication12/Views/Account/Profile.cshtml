@model WebApplication12.Models.ApplicationUser
@{
    ViewData["Title"] = "My Profile";
}

<div class="container py-5">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 rounded-4 px-4 py-3 mb-4 shadow-sm" role="alert" style="background-color: #eafff8; color: #2ed573; border-left: 5px solid #2ed573 !important;">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 rounded-4 px-4 py-3 mb-4 shadow-sm" role="alert" style="background-color: #fff5f5; color: #ff4757; border-left: 5px solid #ff4757 !important;">
            <i class="fa-solid fa-circle-exclamation me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="profile-card animate-pop-in">
                <div class="profile-header text-center">
                    <div class="profile-avatar-wrapper mx-auto mb-3">
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl" alt="@Model.Name" class="profile-avatar">
                        }
                        else
                        {
                            <div class="profile-avatar-placeholder">
                                <i class="fa-solid fa-user fs-1"></i>
                            </div>
                        }
                    </div>
                    <h2 class="profile-name">@Model.Name</h2>
                    <span class="badge-role d-inline-block mb-3">@Model.UserRole.ToUpper()</span>
                    <div>
                        <button type="button" class="btn btn-sm btn-outline-light rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#editProfileModal">
                            <i class="fa-solid fa-pen-to-square me-1"></i> Edit Profile
                        </button>
                    </div>
                </div>

                <div class="profile-body">
                    <div class="info-row">
                        <div class="info-label"><i class="fa-solid fa-envelope me-2"></i> Email</div>
                        <div class="info-value">@Model.Email</div>
                    </div>
                    <div class="info-row">
                        <div class="info-label"><i class="fa-solid fa-phone me-2"></i> Phone</div>
                        <div class="info-value">@Model.Phone</div>
                    </div>
                    <div class="info-row">
                        <div class="info-label"><i class="fa-solid fa-crown me-2"></i> Subscription</div>
                        <div class="info-value">
                            @if (Model.IsPaidMember)
                            {
                                <span class="badge bg-success rounded-pill px-3 py-2">@Model.SubscriptionType — Active</span>
                            }
                            else if (!string.IsNullOrEmpty(Model.SubscriptionType) && Model.SubscriptionType != "Guest")
                            {
                                <span class="badge bg-danger rounded-pill px-3 py-2">@Model.SubscriptionType — Expired</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary rounded-pill px-3 py-2">Free Tier (Guest)</span>
                            }
                        </div>
                    </div>
                    @if (Model.SubscriptionEndDate.HasValue)
                    {
                        <div class="info-row">
                            <div class="info-label"><i class="fa-solid fa-calendar me-2"></i> Expires</div>
                            <div class="info-value">@Model.SubscriptionEndDate?.ToString("MMMM dd, yyyy")</div>
                        </div>
                    }
                    <div class="info-row">
                        <div class="info-label"><i class="fa-solid fa-circle-check me-2"></i> Verified</div>
                        <div class="info-value">
                            @if (Model.VerifyStatus == true)
                            {
                                <span class="text-success"><i class="fa-solid fa-check-circle"></i> Yes</span>
                            }
                            else
                            {
                                <span class="text-danger"><i class="fa-solid fa-times-circle"></i> No</span>
                            }
                        </div>
                    </div>
                </div>

                @if (!Model.IsPaidMember)
                {
                    <div class="upgrade-section p-4" style="background: var(--soft-gold); border-top: 2px dashed var(--luxury-gold);">
                        <h5 class="fw-bold text-center mb-3" style="font-family: 'Playfair Display', serif; color: var(--luxury-black);">Upgrade to Premium Membership</h5>
                        <form asp-controller="Account" asp-action="Upgrade" method="post">
                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="small fw-bold">Select Plan</label>
                                    <select name="subscriptionType" class="form-select rounded-pill-custom">
                                        <option value="Monthly">Monthly Member ($15/mo)</option>
                                        <option value="Yearly">Yearly Member ($150/yr)</option>
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label class="small fw-bold">Card Number</label>
                                    <input type="text" name="CardNumber" class="form-control rounded-pill-custom" placeholder="XXXX XXXX XXXX XXXX" required />
                                </div>
                                <div class="col-6">
                                    <label class="small fw-bold">Expiry Date</label>
                                    <input type="text" name="CardExpiry" class="form-control rounded-pill-custom" placeholder="MM/YY" required />
                                </div>
                                <div class="col-6">
                                    <label class="small fw-bold">CVV</label>
                                    <input type="password" name="CardCvv" class="form-control rounded-pill-custom" placeholder="123" required />
                                </div>
                                <div class="col-12 text-center mt-4">
                                    <button type="submit" class="btn-profile-action w-100">Upgrade Now</button>
                                </div>
                            </div>
                        </form>
                    </div>
                }

                @{
                    var submissions = ViewBag.Submissions as IEnumerable<WebApplication12.Models.UserSubmission>;
                    if (submissions != null && submissions.Any(s => s.Status == "Selected"))
                    {
                        <div class="certificates-section px-4 pb-4">
                            <h6 class="fw-bold text-uppercase border-bottom pb-2 mb-3 mt-2" style="font-size: 13px; color: var(--luxury-gold);">
                                <i class="fa-solid fa-award me-2"></i> Awards & Certificates
                            </h6>
                            <div class="row g-3">
                                @foreach (var sub in submissions.Where(s => s.Status == "Selected"))
                                {
                                    <div class="col-12">
                                        <div class="certificate-box d-flex justify-content-between align-items-center p-3 rounded" style="background: #fdfdfd; border: 1px dashed var(--luxury-gold);">
                                            <div>
                                                <div class="fw-bold mb-1" style="color: var(--luxury-black);">@sub.RecipeName</div>
                                                <span class="badge bg-success" style="font-size: 10px;">Winner ($@sub.PrizeMoney)</span>
                                            </div>
                                            @if (!string.IsNullOrEmpty(sub.CertificateUrl))
                                            {
                                                <a href="@sub.CertificateUrl" target="_blank" class="btn btn-sm btn-dark">
                                                    <i class="fa-solid fa-download me-1"></i> View Certificate
                                                </a>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }

                @{
                    var orders = ViewBag.Orders as IEnumerable<WebApplication12.Models.BookOrder>;
                    if (orders != null && orders.Any())
                    {
                        <div class="orders-section px-4 pb-4">
                            <h6 class="fw-bold text-uppercase border-bottom pb-2 mb-3 mt-4" style="font-size: 13px; color: var(--luxury-gold);">
                                <i class="fa-solid fa-box me-2"></i> My Book Orders
                            </h6>
                            <div class="row g-3">
                                @foreach (var order in orders)
                                {
                                    var badgeClass = order.Status == "Completed" ? "bg-success" : (order.Status == "Cancelled" ? "bg-danger" : "bg-warning text-dark");
                                    <div class="col-12">
                                        <div class="d-flex justify-content-between align-items-center p-3 rounded" style="background: #fdfdfd; border: 1px dashed #ccc;">
                                            <div class="d-flex align-items-center">
                                                @if (order.Book != null && !string.IsNullOrEmpty(order.Book.ImageUrl))
                                                {
                                                    <img src="@order.Book.ImageUrl" alt="@order.Book.Title" class="rounded me-3" style="width: 50px; height: 50px; object-fit: cover;">
                                                }
                                                else
                                                {
                                                    <div class="rounded me-3 bg-light d-flex align-items-center justify-content-center text-muted" style="width: 50px; height: 50px;">
                                                        <i class="fa-solid fa-book"></i>
                                                    </div>
                                                }
                                                <div>
                                                    <div class="fw-bold mb-1" style="color: var(--luxury-black);">@(order.Book?.Title ?? "Book")</div>
                                                    <div class="small text-muted">@order.OrderDate.ToString("MMM dd, yyyy") &bull; $@order.TotalCost.ToString("N2")</div>
                                                </div>
                                            </div>
                                            <div>
                                                <span class="badge @badgeClass rounded-pill px-3 py-2">@order.Status</span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }

                <div class="profile-actions text-center">
                    <a asp-controller="Recipes" asp-action="Index" class="btn-profile-action">
                        <i class="fa-solid fa-ice-cream me-2"></i> Browse Flavors
                    </a>
                    <a asp-controller="Books" asp-action="Index" class="btn-profile-action-outline">
                        <i class="fa-solid fa-book me-2"></i> Order Books
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Edit Profile Modal -->
<div class="modal fade" id="editProfileModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-bottom" style="background-color: var(--luxury-black); color: var(--luxury-gold);">
                <h5 class="modal-title fw-bold" style="font-family: 'Playfair Display', serif;">Edit Profile Settings</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Account" asp-action="UpdateProfile" method="post" enctype="multipart/form-data">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark">Full Name</label>
                        <input type="text" name="name" class="form-control rounded-pill-custom" value="@Model.Name" required maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark">Phone Number</label>
                        <input type="text" name="phone" class="form-control rounded-pill-custom" value="@Model.Phone" required pattern="^03\d{9}$" title="Phone number must start with 03 and be exactly 11 digits." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark">Profile Image</label>
                        <input type="file" name="imageFile" class="form-control rounded-pill-custom" accept="image/*" />
                        <small class="text-muted ms-2">Leave empty to keep your current image.</small>
                    </div>
                </div>
                <div class="modal-footer border-top p-3 bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-profile-action" style="padding: 10px 25px;">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>


<style>
    .profile-card {
        background: white;
        border: 1px solid #eee;
        overflow: hidden;
        box-shadow: 0 20px 60px rgba(0,0,0,0.08);
    }

    .profile-header {
        background: var(--luxury-black);
        padding: 50px 30px 40px;
        border-bottom: 3px solid var(--luxury-gold);
    }

    .profile-avatar-wrapper {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        overflow: hidden;
        border: 4px solid var(--luxury-gold);
    }

    .profile-avatar {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .profile-avatar-placeholder {
        width: 100%;
        height: 100%;
        background: var(--primary-chocolate);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--luxury-gold);
    }

    .profile-name {
        font-family: 'Playfair Display', serif;
        color: var(--accent-vanilla);
        text-transform: uppercase;
        letter-spacing: 3px;
        font-weight: 700;
        margin-top: 15px;
        margin-bottom: 10px;
    }

    .badge-role {
        background: var(--luxury-gold);
        color: var(--luxury-black);
        padding: 6px 20px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 2px;
    }

    .profile-body {
        padding: 40px;
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 18px 0;
        border-bottom: 1px solid #f0f0f0;
    }

    .info-row:last-child { border-bottom: none; }

    .info-label {
        font-weight: 700;
        color: var(--luxury-black);
        text-transform: uppercase;
        font-size: 12px;
        letter-spacing: 1px;
    }

    .info-value {
        color: #666;
        font-size: 14px;
    }

    .profile-actions {
        padding: 30px 40px 40px;
        display: flex;
        gap: 15px;
        justify-content: center;
    }

    .btn-profile-action {
        background: var(--luxury-gold);
        color: var(--luxury-black);
        padding: 14px 35px;
        text-decoration: none;
        text-transform: uppercase;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1px;
        transition: 0.3s;
    }

    .btn-profile-action:hover {
        background: var(--luxury-black);
        color: var(--luxury-gold);
    }

    .btn-profile-action-outline {
        border: 1px solid var(--luxury-gold);
        color: var(--luxury-black);
        padding: 14px 35px;
        text-decoration: none;
        text-transform: uppercase;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1px;
        transition: 0.3s;
    }

    .btn-profile-action-outline:hover {
        background: var(--luxury-gold);
        color: var(--luxury-black);
    }

    .animate-pop-in { animation: popIn 0.6s ease-out; }
    @@keyframes popIn {
        from { opacity: 0; transform: scale(0.95) translateY(20px); }
        to { opacity: 1; transform: scale(1) translateY(0); }
    }

    .rounded-pill-custom {
        border-radius: 50px !important;
        padding: 10px 20px;
        border: 1px solid #ccc;
    }
</style>
