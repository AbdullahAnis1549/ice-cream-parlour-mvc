@model dynamic
@{
    ViewData["Title"] = "Welcome Back";
}

<div class="auth-container">
    <div class="auth-card animate-pop-in">
        <div class="auth-header">
            <div class="ice-cream-icon">🍨</div>
            <h1>Welcome Back</h1>
            <p>Ready for another scoop of happiness?</p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="success-alert">
                @TempData["SuccessMessage"]
            </div>
        }

        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="error-summary"></div>

            <div class="input-group">
                <label for="email">Email Address</label>
                <input type="email" name="email" id="email" placeholder="example@gmail.com" required />
            </div>

            <div class="input-group">
                <label for="password">Password</label>
                <input type="password" name="password" id="password" placeholder="••••••••" required />
            </div>

            <div class="forgot-link">
                <a asp-action="ForgotPassword">Forgot Password?</a>
            </div>

            <button type="submit" class="btn-primary">Login & Enjoy</button>

            <div class="auth-footer">
                Don't have an account? <a asp-action="Register">Join the Parlor</a>
            </div>
        </form>
    </div>
</div>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&family=Fredoka:wght@400;600&display=swap');

    :root {
        --primary-blue: #1a1a1a;
        --mehran-gold: #d4af37;
        --secondary-cream: #fbf7ef;
        --text-dark: #1a1a1a;
    }

    body {
        margin: 0;
        background: linear-gradient(135deg, #1a1a1a 0%, #3e2723 100%);
        min-height: 100vh;
        font-family: 'Poppins', sans-serif;
    }

    .auth-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 80vh;
        padding: 20px;
    }

    .auth-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        padding: 40px;
        border-radius: 24px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
        max-width: 400px;
        width: 100%;
        border: 4px solid var(--mehran-gold);
    }

    .animate-pop-in {
        animation: popIn 0.6s cubic-bezier(0.17, 0.67, 0.83, 0.67);
    }

    @@keyframes popIn {
        from { opacity: 0; transform: scale(0.9); }
        to { opacity: 1; transform: scale(1); }
    }

    .auth-header {
        text-align: center;
        margin-bottom: 30px;
    }

    .ice-cream-icon {
        font-size: 50px;
        margin-bottom: 10px;
    }

    .auth-header h1 {
        font-family: 'Fredoka', sans-serif;
        color: var(--primary-blue);
        font-size: 32px;
        margin: 0;
    }

    .auth-header p {
        color: #888;
        font-size: 14px;
    }

    .input-group {
        margin-bottom: 20px;
    }

    .input-group label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
        color: var(--text-dark);
        font-size: 14px;
    }

    .input-group input {
        width: 100%;
        padding: 12px 16px;
        border: 2px solid #eee;
        border-radius: 12px;
        font-size: 15px;
        transition: all 0.3s;
        box-sizing: border-box;
    }

    .input-group input:focus {
        border-color: var(--primary-blue);
        outline: none;
        box-shadow: 0 0 0 4px rgba(0, 74, 153, 0.1);
    }

    .btn-primary {
        width: 100%;
        background: var(--primary-blue);
        color: var(--mehran-gold);
        border: 2px solid var(--mehran-gold);
        padding: 14px;
        border-radius: 12px;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        transition: 0.3s;
        margin-top: 10px;
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
    }

    .btn-primary:hover {
        background: var(--mehran-gold);
        color: var(--primary-blue);
        transform: translateY(-2px);
    }

    .forgot-link {
        text-align: right;
        margin-bottom: 20px;
        margin-top: -10px;
    }

    .forgot-link a {
        font-size: 13px;
        color: #888;
        text-decoration: none;
    }

    .auth-footer {
        text-align: center;
        margin-top: 25px;
        font-size: 14px;
        color: #777;
    }

    .auth-footer a {
        color: var(--primary-blue);
        text-decoration: none;
        font-weight: 700;
    }

    .success-alert {
        background: #eafff8;
        color: #2ed573;
        padding: 12px;
        border-radius: 12px;
        margin-bottom: 20px;
        font-size: 13px;
        border: 1px solid #c2f9e4;
        text-align: center;
    }

    .error-summary {
        background: #fff5f5;
        border-left: 4px solid #ff4757;
        padding: 10px;
        margin-bottom: 20px;
        border-radius: 4px;
        color: #ff4757;
        font-size: 13px;
    }
</style>
