@model IEnumerable<WebApplication12.Models.Recipe>
@{
    ViewData["Title"] = "Manage Recipes";
}

<div class="container py-5">
    <div class="d-flex flex-wrap gap-3 justify-content-between align-items-center mb-5 border-bottom border-dark pb-3">
        <h2 class="text-uppercase fw-bold" style="font-family: 'Playfair Display', serif; letter-spacing: 2px;">Flavor Inventory</h2>
        <a asp-action="CreateRecipe" class="btn btn-luxury-add">+ New Collection Item</a>
    </div>

    <div class="bg-white rounded-4 shadow-sm table-responsive" tabindex="0" role="region" aria-label="Management table">
        <table class="table table-hover mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4">Flavor</th>
                    <th>Type</th>
                    <th>Ingredients</th>
                    <th>Procedure</th>
                    <th class="pe-4 text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <div class="d-flex align-items-center">
                                <img src="@item.ImageUrl" class="rounded-circle me-3" style="width: 40px; height: 40px; object-fit: cover;">
                                <strong>@item.Name</strong>
                            </div>
                        </td>
                        <td>
                            <span class="badge @(item.IsFree ? "badge-free" : "badge-premium")">
                                @(item.IsFree ? "Common" : "Gold Collection")
                            </span>
                        </td>
                        <td class="text-truncate" style="max-width: 200px;">@item.Ingredients</td>
                        <td class="text-truncate" style="max-width: 200px;">@item.Procedure</td>
                        <td class="pe-4 text-end">
                            <div class="d-flex justify-content-end gap-2">
                                <a asp-action="EditRecipe" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark" style="font-size: 10px; text-transform: uppercase;">Refine</a>
                                <form asp-action="DeleteRecipe" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Archive this entry permanently?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" style="font-size: 10px; text-transform: uppercase;">Abolish</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .btn-luxury-add { 
        background: var(--luxury-black); 
        color: var(--luxury-gold); 
        border: 1px solid var(--luxury-gold); 
        text-transform: uppercase; 
        font-size: 11px; 
        letter-spacing: 1px; 
        padding: 10px 20px;
    }
    .btn-luxury-add:hover { background: var(--luxury-gold); color: var(--luxury-black); }
    .table thead th { border-top: none; background: #000; color: #fff; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; padding: 15px; }
    .table tbody td { vertical-align: middle; padding: 15px; font-size: 14px; }
    .badge-premium { background: var(--luxury-gold); color: var(--luxury-black); }
    .badge-free { background: #eee; color: #333; }
</style>
