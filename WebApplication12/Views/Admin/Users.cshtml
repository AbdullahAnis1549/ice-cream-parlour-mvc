@model IEnumerable<WebApplication12.Models.ApplicationUser>
@{
    ViewData["Title"] = "Manage Users";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="fa-solid fa-users me-2 text-primary"></i> Registered Customers</h2>
        <a asp-action="Dashboard" class="btn btn-outline-secondary rounded-pill px-4"><i class="fa-solid fa-arrow-left me-2"></i> Dashboard</a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">User</th>
                        <th>Email / Phone</th>
                        <th>Subscription</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Expiry Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    <img src="@(string.IsNullOrEmpty(user.ImageUrl) ? "https://ui-avatars.com/api/?name=" + user.Name : user.ImageUrl)" class="rounded-circle me-3" style="width: 40px; height: 40px; object-fit: cover;">
                                    <div>
                                        <div class="fw-bold">@user.Name</div>
                                        <div class="small text-muted">@user.UserRole</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="small fw-bold">@user.Email</div>
                                <div class="small text-muted">@user.Phone</div>
                            </td>
                            <td>
                                @if (user.SubscriptionType != null)
                                {
                                    <span class="badge @(user.SubscriptionType == "Yearly" ? "bg-success" : "bg-info") rounded-pill">@user.SubscriptionType</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary rounded-pill">Free Tier</span>
                                }
                            </td>
                            <td>
                                @if (user.IsPaidMember)
                                {
                                    <span class="text-success"><i class="fa-solid fa-circle-check me-1"></i> Active</span>
                                }
                                else
                                {
                                    <span class="text-danger"><i class="fa-solid fa-circle-xmark me-1"></i> Expired/None</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                @(user.SubscriptionEndDate?.ToString("MMM dd, yyyy") ?? "N/A")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
