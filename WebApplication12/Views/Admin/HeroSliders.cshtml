@model IEnumerable<WebApplication12.Models.HeroSlider>
@{
    ViewData["Title"] = "Manage Hero Sliders";
}

<div class="container py-5">
    <div class="d-flex flex-wrap gap-3 justify-content-between align-items-center mb-4">
        <h2 class="admin-title">Manage Hero Carousel</h2>
        <a asp-action="CreateHeroSlider" class="btn btn-luxury-outline">
            <i class="fa-solid fa-plus me-2"></i> Add New Slide
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="px-4 py-3" style="width: 15%">Preview</th>
                            <th class="px-4 py-3">Title</th>
                            <th class="px-4 py-3">Subtitle</th>
                            <th class="px-4 py-3 text-center">Order</th>
                            <th class="px-4 py-3 text-end" style="width: 20%">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var slide in Model)
                            {
                                <tr>
                                    <td class="px-4 py-3">
                                        @if (!string.IsNullOrEmpty(slide.ImageUrl))
                                        {
                                            <img src="@slide.ImageUrl" class="rounded object-fit-cover" style="width: 100px; height: 60px;" />
                                        }
                                        else
                                        {
                                            <div class="bg-light rounded d-flex align-items-center justify-content-center" style="width: 100px; height: 60px;">
                                                <i class="fa-solid fa-image text-muted fs-4"></i>
                                            </div>
                                        }
                                    </td>
                                    <td class="px-4 py-3 fw-bold">@Html.Raw(slide.Title)</td>
                                    <td class="px-4 py-3 text-muted">@slide.Subtitle</td>
                                    <td class="px-4 py-3 text-center">
                                        <span class="badge bg-dark rounded-pill px-3">@slide.DisplayOrder</span>
                                    </td>
                                    <td class="px-4 py-3 text-end">
                                        <a asp-action="EditHeroSlider" asp-route-id="@slide.Id" class="btn btn-sm btn-outline-secondary me-2">
                                            <i class="fa-solid fa-pen"></i> Edit
                                        </a>
                                        <form asp-action="DeleteHeroSlider" asp-route-id="@slide.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this slide?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="fa-solid fa-trash"></i> Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="fa-solid fa-images fs-1 mb-3 opacity-25"></i>
                                    <p class="mb-0">No slides configured. Default slides will be shown.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --luxury-gold: #D9A066;
        --luxury-black: #4B2E2B;
    }

    body { background: #FFF3E0; }
    
    .admin-title { font-family: 'Playfair Display', serif; font-weight: 700; color: var(--luxury-black); text-transform: uppercase; letter-spacing: 2px; }
    
    .btn-luxury-outline { 
        background: white; 
        border: 1px solid var(--luxury-gold); 
        color: var(--luxury-black); 
        text-transform: uppercase; 
        font-size: 11px; 
        font-weight: 600;
        letter-spacing: 1px;
        padding: 10px 20px;
        transition: 0.3s;
    }
    .btn-luxury-outline:hover {
        background: var(--luxury-gold);
        color: var(--pure-white);
    }
</style>
