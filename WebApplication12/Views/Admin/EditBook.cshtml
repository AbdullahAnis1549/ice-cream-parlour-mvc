@model WebApplication12.Models.Book
@{
    ViewData["Title"] = "Refine Edition";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 animate-slide-up">
            <div class="card border-0 shadow-sm" style="border-top: 5px solid var(--luxury-gold) !important;">
                <div class="card-header bg-dark text-white p-4">
                    <h3 class="mb-0 fw-bold text-uppercase" style="font-family: 'Playfair Display', serif; letter-spacing: 2px;">
                        <span style="color: var(--luxury-gold);">#</span> Edit Edition
                    </h3>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form asp-action="EditBook" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="Id" />
                        <div class="row g-4">
                            <div class="col-md-9">
                                <label asp-for="Title" class="form-label text-uppercase small fw-bold">Edition Title</label>
                                <input asp-for="Title" class="form-control" placeholder="e.g. The Artisanal Extraction" required />
                            </div>
                            <div class="col-md-3">
                                <label asp-for="Price" class="form-label text-uppercase small fw-bold">Appraisal ($)</label>
                                <input asp-for="Price" class="form-control" type="number" step="0.01" required />
                            </div>
                            
                            <div class="col-12">
                                <label asp-for="Description" class="form-label text-uppercase small fw-bold">Edition Abstract</label>
                                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Brief overview of the book's content..."></textarea>
                            </div>

                            <div class="col-12">
                                <label class="form-label text-uppercase small fw-bold">Current Imagery</label>
                                <div class="mb-3">
                                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                                    {
                                        <img src="@Model.ImageUrl" class="img-thumbnail" style="max-height: 150px;" />
                                    }
                                    else
                                    {
                                        <div class="p-3 bg-light text-muted small">No imagery archived for this edition.</div>
                                    }
                                </div>
                                <label asp-for="ImageFile" class="form-label text-uppercase small fw-bold">Update Cover (Upload File)</label>
                                <input asp-for="ImageFile" class="form-control" type="file" accept="image/*" />
                                <div class="form-text small">Uploading a new file will replace the current imagery.</div>
                            </div>
                        </div>

                        <div class="mt-5 d-flex gap-3">
                            <button type="submit" class="btn-luxury-submit">Update Archive</button>
                            <a asp-action="Books" class="btn-luxury-cancel">Revert</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .form-control {
        border-radius: 0;
        border: 1px solid #ddd;
        padding: 12px;
    }
    .form-control:focus {
        border-color: var(--luxury-gold);
        box-shadow: none;
    }
    
    .btn-luxury-submit {
        background: var(--luxury-black);
        color: var(--luxury-gold);
        border: 1px solid var(--luxury-gold);
        padding: 15px 40px;
        text-transform: uppercase;
        font-weight: 700;
        letter-spacing: 2px;
        font-size: 11px;
        transition: 0.4s;
    }
    .btn-luxury-submit:hover {
        background: var(--luxury-gold);
        color: var(--luxury-black);
    }

    .btn-luxury-cancel {
        background: white;
        color: #888;
        border: 1px solid #eee;
        padding: 15px 40px;
        text-transform: uppercase;
        font-weight: 700;
        letter-spacing: 2px;
        font-size: 11px;
        text-decoration: none;
        transition: 0.3s;
    }
    .btn-luxury-cancel:hover {
        background: #f5f5f5;
        color: #333;
    }

    .animate-slide-up {
        animation: fadeInUp 0.6s ease-out;
    }
    @@keyframes fadeInUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
