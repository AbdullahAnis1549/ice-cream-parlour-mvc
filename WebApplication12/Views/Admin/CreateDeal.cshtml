@model WebApplication12.Models.Deal
@{
    ViewData["Title"] = "Archive New Deal";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm" style="border-top: 5px solid var(--luxury-gold) !important;">
                <div class="card-header bg-dark text-white p-4">
                    <h3 class="mb-0 fw-bold text-uppercase" style="font-family: 'Playfair Display', serif; letter-spacing: 2px;">
                        <span style="color: var(--luxury-gold);">+</span> New Offer Registry
                    </h3>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form asp-action="CreateDeal" method="post" enctype="multipart/form-data">
                        <div class="row g-4">
                            <div class="col-md-9">
                                <label asp-for="Title" class="form-label text-uppercase small fw-bold">Offer Title</label>
                                <input asp-for="Title" class="form-control" placeholder="e.g. The Party Vault" required />
                            </div>
                            <div class="col-md-3">
                                <label asp-for="Price" class="form-label text-uppercase small fw-bold">Price ($)</label>
                                <input asp-for="Price" class="form-control" type="number" step="0.01" required />
                            </div>
                            
                            <div class="col-md-6">
                                <label asp-for="Tagline" class="form-label text-uppercase small fw-bold">Subtitle / Tagline</label>
                                <input asp-for="Tagline" class="form-control" placeholder="e.g. 5 LITRE BUCKET" />
                            </div>

                            <div class="col-md-6">
                                <label asp-for="BadgeText" class="form-label text-uppercase small fw-bold">Badge Text</label>
                                <input asp-for="BadgeText" class="form-control" placeholder="e.g. SAVE 15%" />
                            </div>

                            <div class="col-12">
                                <label asp-for="Description" class="form-label text-uppercase small fw-bold">Offer Context</label>
                                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Describe the inclusions and provisions..."></textarea>
                            </div>

                            <div class="col-md-8">
                                <label asp-for="ImageFile" class="form-label text-uppercase small fw-bold">Offer Imagery (Upload File)</label>
                                <input asp-for="ImageFile" class="form-control" type="file" accept="image/*" />
                            </div>

                            <div class="col-md-4 d-flex align-items-end">
                                <div class="form-check form-switch mb-2">
                                    <input asp-for="IsHighlighted" class="form-check-input" type="checkbox" id="highlightSwitch">
                                    <label class="form-check-label text-uppercase small fw-bold" for="highlightSwitch">Feature on Main</label>
                                </div>
                            </div>
                        </div>

                        <div class="mt-5 d-flex gap-3">
                            <button type="submit" class="btn-luxury-submit">Register Offer</button>
                            <a asp-action="Deals" class="btn-luxury-cancel">Discard</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .form-control { border-radius: 0; border: 1px solid #ddd; padding: 12px; }
    .form-control:focus { border-color: var(--luxury-gold); box-shadow: none; }
    .form-check-input:checked { background-color: var(--luxury-gold); border-color: var(--luxury-gold); }
    
    .btn-luxury-submit {
        background: var(--luxury-black);
        color: var(--luxury-gold);
        border: 1px solid var(--luxury-gold);
        padding: 15px 40px;
        text-transform: uppercase;
        font-weight: 700;
        letter-spacing: 2px;
        font-size: 11px;
        transition: 0.4s;
    }
    .btn-luxury-submit:hover { background: var(--luxury-gold); color: var(--luxury-black); }

    .btn-luxury-cancel {
        background: white;
        color: #888;
        border: 1px solid #eee;
        padding: 15px 40px;
        text-transform: uppercase;
        font-weight: 700;
        letter-spacing: 2px;
        font-size: 11px;
        text-decoration: none;
        transition: 0.3s;
    }
    .btn-luxury-cancel:hover { background: #f5f5f5; color: #333; }
</style>
