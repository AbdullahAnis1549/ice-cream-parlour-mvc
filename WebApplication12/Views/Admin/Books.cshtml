@model IEnumerable<WebApplication12.Models.Book>
@{
    ViewData["Title"] = "The Archive Inventory";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-5 border-bottom border-dark pb-3 animate-slide-up">
        <h2 class="text-uppercase fw-bold" style="font-family: 'Playfair Display', serif; letter-spacing: 2px;">The Archive Inventory</h2>
        <a asp-action="CreateBook" class="btn-luxury-add">+ Archive New Edition</a>
    </div>

    <div class="bg-white shadow-sm overflow-hidden animate-slide-up">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th class="ps-4">Edition</th>
                    <th>Appraisal</th>
                    <th>Description</th>
                    <th class="pe-4 text-end">Management</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <div class="d-flex align-items-center">
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" class="rounded-0 me-3" style="width: 45px; height: 60px; object-fit: cover; border: 1px solid #ddd;">
                                }
                                else
                                {
                                    <div class="bg-dark text-white d-flex align-items-center justify-content-center me-3" style="width: 45px; height: 60px; font-size: 10px; border: 1px solid var(--luxury-gold);">NO IMG</div>
                                }
                                <div>
                                    <strong class="text-uppercase small" style="letter-spacing: 1px;">@item.Title</strong>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="badge border border-dark text-dark fw-bold">$@item.Price</span>
                        </td>
                        <td class="text-truncate" style="max-width: 300px; font-size: 13px; color: #666;">@item.Description</td>
                        <td class="pe-4 text-end">
                            <div class="d-flex justify-content-end gap-2">
                                <a asp-action="EditBook" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark" style="font-size: 10px; text-transform: uppercase;">Refine</a>
                                <form asp-action="DeleteBook" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Remove this edition from the archive?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" style="font-size: 10px; text-transform: uppercase;">Abolish</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .btn-luxury-add { 
        background: var(--luxury-black); 
        color: var(--luxury-gold); 
        border: 1px solid var(--luxury-gold); 
        text-transform: uppercase; 
        font-size: 11px; 
        letter-spacing: 2px; 
        padding: 12px 25px;
        text-decoration: none;
        font-weight: 700;
    }
    .btn-luxury-add:hover { background: var(--luxury-gold); color: var(--luxury-black); }
    
    .table thead th { border-top: none; background: #000; color: #fff; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; padding: 18px; }
    .table tbody td { vertical-align: middle; padding: 18px; }

    .animate-slide-up {
        animation: fadeInUp 0.6s ease-out;
    }
    @@keyframes fadeInUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
