@model IEnumerable<WebApplication12.Models.Deal>
@{
    ViewData["Title"] = "Manage Promotional Deals";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-5 border-bottom border-dark pb-3">
        <h2 class="text-uppercase fw-bold" style="font-family: 'Playfair Display', serif; letter-spacing: 2px;">Promotional Deals</h2>
        <a asp-action="CreateDeal" class="btn-luxury-add">+ Archive New Deal</a>
    </div>

    <div class="bg-white shadow-sm overflow-hidden">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th class="ps-4">Deal Details</th>
                    <th>Appraisal</th>
                    <th>Badge</th>
                    <th>Highlight</th>
                    <th class="pe-4 text-end">Management</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <div class="d-flex align-items-center">
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" class="rounded-0 me-3" style="width: 60px; height: 40px; object-fit: cover; border: 1px solid #ddd;">
                                }
                                else
                                {
                                    <div class="bg-dark text-white d-flex align-items-center justify-content-center me-3" style="width: 60px; height: 40px; font-size: 10px; border: 1px solid var(--luxury-gold);">NO IMG</div>
                                }
                                <div>
                                    <strong class="text-uppercase small" style="letter-spacing: 1px;">@item.Title</strong>
                                    <div class="text-muted" style="font-size: 11px;">@item.Tagline</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="fw-bold">$@item.Price</span>
                        </td>
                        <td>
                            <span class="badge border border-dark text-dark">@item.BadgeText</span>
                        </td>
                        <td>
                            @if (item.IsHighlighted)
                            {
                                <span class="text-gold"><i class="fa-solid fa-star"></i> Featured</span>
                            }
                            else
                            {
                                <span class="text-muted small">Standard</span>
                            }
                        </td>
                        <td class="pe-4 text-end">
                            <div class="d-flex justify-content-end gap-2">
                                <a asp-action="EditDeal" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark" style="font-size: 10px; text-transform: uppercase;">Refine</a>
                                <form asp-action="DeleteDeal" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Archive this offer permanently?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" style="font-size: 10px; text-transform: uppercase;">Abolish</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .btn-luxury-add { 
        background: var(--luxury-black); 
        color: var(--luxury-gold); 
        border: 1px solid var(--luxury-gold); 
        text-transform: uppercase; 
        font-size: 11px; 
        letter-spacing: 2px; 
        padding: 12px 25px;
        text-decoration: none;
        font-weight: 700;
    }
    .btn-luxury-add:hover { background: var(--luxury-gold); color: var(--luxury-black); }
    
    .table thead th { border-top: none; background: #000; color: #fff; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; padding: 18px; }
    .table tbody td { vertical-align: middle; padding: 18px; }
    .text-gold { color: var(--luxury-gold); }
</style>
